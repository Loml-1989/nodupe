{
    "manifest_version": 3,
    "name": "NoDupe",
    "version": "1.0",
    "description": "Closes all duplicate tabs to free up RAM!!",
    "permissions": ["tabs"],
    "action": {
        "default_popup": "popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "contact@tuxotaku.tech"
        }
    }
}